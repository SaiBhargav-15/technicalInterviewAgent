{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "server.ts": {
      "includeFiles": [
        "config/recruiter-allowlist.json",
        "data/*.json"
      ]
    }
  }
}
